# Copy this file to .env (same folder) and fill it in. .env is in .gitignore — never commit it.

# Leave DATABASE_URL blank to use the built-in embedded database (server/.data/), which needs no setup.
# To share one database with the whole team, paste a Postgres connection string from Supabase or Neon:
#   Supabase: Project Settings > Database > Connection string > URI   (use the "Session pooler" one)
#   Neon:     Dashboard > Connection Details
DATABASE_URL=

# Port for the web demo + API. Open http://localhost:3000 after `npm start`.
PORT=3000
